# Omnigistic — Environment Variables
# Copy file ini ke .env.local, isi sesuai provider masing2.
# SEMUA field WAJIB diisi dari environment, jangan hard-code di source.

# Database (Postgres serverless — ganti sesuai provider & kredensial)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# AI API yang kompatibel dengan OpenAI format
# ganti dengan base URL, key & model sesuai penyedia yang kamu pakai
AI_API_BASE_URL=https://api.provider-name.example.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here
